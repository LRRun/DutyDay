{
  "name": "duty-day",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack && npm run build:worker",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-worker/index.cjs --external:@prisma/client --external:nodemailer",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:bootstrap": "node prisma/bootstrap.cjs",
    "db:seed": "node prisma/seed.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@prisma/client": "^6.12.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "lucide-react": "0.542.0",
    "mustache": "^4.2.0",
    "next": "^16.3.4",
    "nodemailer": "^10.0.0",
    "prisma": "^6.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "7.62.0",
    "sharp": "^0.35.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.3.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.6",
    "@types/node": "22.18.0",
    "@types/nodemailer": "7.0.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "10.4.21",
    "esbuild": "0.25.9",
    "postcss": "^8.5.23",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  },
  "engines": {
    "node": ">=20"
  }
}
